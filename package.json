{
  "name": "Moonlit",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "tsc": "tsc --noEmit",
    "start": "react-native start",
    "test": "jest",
    "reverse-port": "adb reverse tcp:8081 tcp:8081",
    "restart": "yarn start --reset-cache",
    "codegen-android": "cd ./android && ./gradlew generateCodegenArtifactsFromSchema",
    "android:check-16kb": "cd ./android && ./gradlew check16KbPageAlignment",
    "pod-reinstall": "cd ./ios && rm -rf ~/Library/Caches/CocoaPods && rm -rf Pods && bundle exec pod install --repo-update && cd ..",
    "postinstall": "patch-package && git config core.hooksPath .githooks",
    "reinstall": "yarn install --immutable && yarn pod-reinstall && yarn codegen-android",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@amplitude/analytics-react-native": "^1.12.4",
